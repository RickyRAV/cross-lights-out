# ---- Postgres (consumed by the db service) ----
POSTGRES_DB=lightsout
POSTGRES_USER=lightsout
POSTGRES_PASSWORD=change_me_locally
POSTGRES_PORT=5434

# ---- API ----
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
API_PORT=3000
LOG_LEVEL=debug
RUN_MIGRATIONS_ON_START=true

# Credentials for the /docs Swagger UI — change these in prod, keep them out
# of anything committed.
DOCS_USERNAME=admin
DOCS_PASSWORD=change_me_locally

# Composed from the values above by docker-compose. Set explicitly when
# running the API on the host instead of in a container.
DATABASE_URL=postgresql://lightsout:lightsout@localhost:5434/lightsout

# ---- Auth (LO-4) ----
JWT_SECRET=GENERATE_A_RANDOM_32_PLUS_CHAR_SECRET
JWT_ISSUER=https://lightsout-api.w11core.cc
JWT_AUDIENCE=lights-out-mobile
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7
