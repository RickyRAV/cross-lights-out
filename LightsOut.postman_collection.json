    {
      "name": "7. Leaderboard",
      "item": [
        {
          "name": "Get Leaderboard (User One)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var leaderboard = pm.response.json();",
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"both members appear\", function () { pm.expect(leaderboard.length).to.eql(2); });",
                  "pm.test(\"nobody scored yet, race hasn't been graded\", function () {",
                  "    leaderboard.forEach(function (entry) {",
                  "        pm.expect(entry.totalPoints).to.eql(0);",
                  "        pm.expect(entry.racesScored).to.eql(0);",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{tokenOne}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseURL}}/api/v1/groups/{{groupId}}/leaderboard",
              "host": ["{{baseURL}}"],
              "path": ["api", "v1", "groups", "{{groupId}}", "leaderboard"]
            }
          },
          "response": []
        },
        {
          "name": "Get Leaderboard - Not a Member (expect 403)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const timestamp = new Date().getTime();",
                  "const email = \"outsider_\" + timestamp + \"@test.com\";",
                  "",
                  "pm.sendRequest({",
                  "    url: pm.collectionVariables.get(\"baseURL\") + \"/api/v1/auth/register\",",
                  "    method: \"POST\",",
                  "    header: { \"Content-Type\": \"application/json\" },",
                  "    body: {",
                  "        mode: \"raw\",",
                  "        raw: JSON.stringify({ email: email, password: \"password123\", displayName: \"Outsider\" })",
                  "    }",
                  "}, function (err, res) {",
                  "    if (err) { console.error(err); return; }",
                  "    pm.collectionVariables.set(\"tokenOutsider\", res.json().accessToken);",
                  "});"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 403\", function () { pm.response.to.have.status(403); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{tokenOutsider}}", "type": "string" }]
            },
            "method": "GET",
