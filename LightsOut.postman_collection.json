        {
          "name": "Get Group Race Predictions - Sealed (User One)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var statuses = pm.response.json();",
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"both members show as submitted\", function () {",
                  "    pm.expect(statuses.length).to.eql(2);",
                  "    statuses.forEach(function (status) { pm.expect(status.submitted).to.be.true; });",
                  "});",
                  "pm.test(\"picks are sealed before lockout\", function () {",
                  "    statuses.forEach(function (status) { pm.expect(status.predictedOrder).to.be.null; });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
