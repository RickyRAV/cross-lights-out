        {
          "name": "List My Groups (User One)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var groups = pm.response.json();",
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"the created group is in the list, with its invite code\", function () {",
                  "    var match = groups.find(function (group) { return group.id === pm.collectionVariables.get(\"groupId\"); });",
                  "    pm.expect(match).to.not.be.undefined;",
                  "    pm.expect(match.inviteCode).to.eql(pm.collectionVariables.get(\"inviteCode\"));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{tokenOne}}", "type": "string" }]
