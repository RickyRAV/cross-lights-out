    {
      "name": "5. Races",
      "item": [
        {
          "name": "List Races (saves an unlocked raceId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var races = pm.response.json();",
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"calendar is not empty\", function () { pm.expect(races.length).to.be.above(0); });",
                  "",
                  "var now = Date.now();",
                  "var upcoming = races.find(function (race) { return new Date(race.lockoutAt).getTime() > now; });",
                  "",
                  "if (upcoming) {",
                  "    pm.collectionVariables.set(\"raceId\", upcoming.raceId);",
                  "    console.log(\"Using upcoming race: \" + upcoming.raceId + \" (\" + upcoming.name + \")\");",
                  "} else {",
                  "    console.warn(\"No upcoming race found in the cached calendar, Submit Prediction will 409\");",
                  "}",
                  "",
                  "var past = races.find(function (race) { return new Date(race.lockoutAt).getTime() <= now; });",
                  "if (past) {",
                  "    pm.collectionVariables.set(\"gradedRaceId\", past.raceId);",
                  "    console.log(\"Using past race for the result check: \" + past.raceId + \" (\" + past.name + \")\");",
                  "} else {",
                  "    console.warn(\"No past race found in the cached calendar, the graded-result check will be skipped\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{tokenOne}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseURL}}/api/v1/races",
              "host": ["{{baseURL}}"],
              "path": ["api", "v1", "races"]
            }
          },
          "response": []
        },
        {
          "name": "Get Race Result - Graded (User One)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var gradedRaceId = pm.collectionVariables.get(\"gradedRaceId\");",
                  "if (!gradedRaceId) {",
                  "    console.warn(\"Skipping: no past race available in this calendar snapshot\");",
                  "} else {",
                  "    pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "    pm.test(\"actual order has 5 drivers\", function () {",
                  "        pm.expect(pm.response.json().actualOrder.length).to.eql(5);",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{tokenOne}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseURL}}/api/v1/races/{{gradedRaceId}}/result",
              "host": ["{{baseURL}}"],
              "path": ["api", "v1", "races", "{{gradedRaceId}}", "result"]
            }
          },
          "response": []
        },
        {
          "name": "Get Race Result - Not Graded Yet (expect 404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 404\", function () { pm.response.to.have.status(404); });"
