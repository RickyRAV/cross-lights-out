  "item": [
    {
      "name": "1. Health",
      "item": [
        {
          "name": "Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"database up\", function () {",
                  "    pm.expect(pm.response.json().database).to.eql(\"up\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseURL}}/api/v1/health",
              "host": ["{{baseURL}}"],
              "path": ["api", "v1", "health"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Auth (User One - Group Creator)",
      "item": [
        {
          "name": "Register User One",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const timestamp = new Date().getTime();",
                  "pm.collectionVariables.set(\"emailOne\", \"racer_one_\" + timestamp + \"@test.com\");",
                  "pm.collectionVariables.set(\"passwordOne\", \"password123\");",
                  "pm.collectionVariables.set(\"displayNameOne\", \"Racer One \" + timestamp);",
                  "console.log(\"--- REGISTERING USER ONE ---\");",
                  "console.log(\"Email: \" + pm.collectionVariables.get(\"emailOne\"));"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
                  "",
                  "pm.collectionVariables.set(\"tokenOne\", jsonData.accessToken);",
                  "pm.collectionVariables.set(\"refreshTokenOne\", jsonData.refreshToken);",
                  "pm.collectionVariables.set(\"userIdOne\", jsonData.user.id);",
                  "console.log(\"User One ID: \" + jsonData.user.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"{{emailOne}}\",\n    \"password\": \"{{passwordOne}}\",\n    \"displayName\": \"{{displayNameOne}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseURL}}/api/v1/auth/register",
              "host": ["{{baseURL}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          },
          "response": []
        },
        {
          "name": "Login User One",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
