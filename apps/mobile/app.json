{
  "expo": {
    "name": "Lights Out",
    "slug": "lights-out",
    "scheme": "lightsout",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "cc.w11core.lightsout"
    },
    "android": {
      "package": "cc.w11core.lightsout",
      "predictiveBackGestureEnabled": false
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
