{
  "name": "@lightsout/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@lightsout/shared": "workspace:*",
    "fastify": "5.12.5",
    "@fastify/basic-auth": "6.3.0",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/jwt": "10.2.2",
    "@fastify/rate-limit": "11.2.0",
    "@node-rs/argon2": "2.2.1",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "fastify-type-provider-zod": "7.0.0",
    "zod": "4.6.5",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0",
    "dotenv": "17.4.2"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.1",
    "@types/node": "24.13.5",
    "@types/pg": "8.23.1"
  }
}
