{
  "name": "lights-out",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "start": "pnpm --filter @lightsout/mobile start",
    "android": "pnpm --filter @lightsout/mobile android",
    "ios": "pnpm --filter @lightsout/mobile ios",
    "api:dev": "pnpm --filter @lightsout/api dev",
    "shared:dev": "pnpm --filter @lightsout/shared dev",
    "db:generate": "pnpm --filter @lightsout/api db:generate",
    "db:migrate": "pnpm --filter @lightsout/api db:migrate",
    "db:studio": "pnpm --filter @lightsout/api db:studio",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:dev": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "typescript-eslint": "8.70.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "15.15.0",
    "prettier": "3.9.7"
  }
}
